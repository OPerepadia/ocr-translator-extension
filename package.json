{
  "name": "screen-ocr-translator",
  "version": "0.12.0",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt -b firefox",
    "dev:chrome": "wxt -b chrome",
    "build": "wxt build -b firefox",
    "build:chrome": "wxt build -b chrome",
    "build-for-amo": "npm run build",
    "zip": "wxt zip -b firefox",
    "zip:chrome": "wxt zip -b chrome",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:browser:chrome": "playwright test",
    "test:browser:firefox": "node --test tests/browser/firefox/ocr-host.test.mjs",
    "test:watch": "vitest",
    "verify:models": "node scripts/verify-models.mjs",
    "quantize:models": "scripts/quantize-models.sh"
  },
  "dependencies": {
    "onnxruntime-web": "^1.26.0",
    "tinyld": "^1.3.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.14.15",
    "fake-indexeddb": "^6.2.5",
    "selenium-webdriver": "^4.47.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.9",
    "web-ext": "^10.4.0",
    "wxt": "^0.21.3"
  }
}
